# ──────────────────────────────────────────────────────────────────────────────
# Alpha-Stream — environment template
# Copy to `backend/.env` and fill in. Nothing here is required to run the demo
# slate; only Kalshi credentials are required for live market data.
# ──────────────────────────────────────────────────────────────────────────────

# Flask — generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
FLASK_SECRET_KEY=replace-with-a-random-string-at-least-32-chars

# Database — defaults to local SQLite if unset. For Postgres:
# DATABASE_URL=postgresql://user:pass@localhost:5432/alphastream
DATABASE_URL=sqlite:///alpha_stream_dev.db

# Kalshi RSA key auth (required for live market data)
# Get both from kalshi.com → API Keys → Create Key (Read/Write)
# Save your RSA private key (PEM format) to backend/kalshi_key.pem — do NOT put it here
KALSHI_KEY_ID=

# App URL (used by email links)
APP_URL=http://localhost:3000

# Admin email — defaults to vineet.sista@gmail.com in models.py if unset
ADMIN_EMAIL=

# Optional: SendGrid for verification + digest emails. If unset, emails are skipped silently.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional: Web Push (VAPID public key). Browser push notifications.
VAPID_PUBLIC_KEY=
